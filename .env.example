# ====================================================================
# Govt. Boys Qazi Sultan Higher Secondary School, Kunri — Production Environment Configuration
# ====================================================================
# IMPORTANT: Never commit production credentials, secret keys, or real
# student data to source control. Copy this template to .env.local for
# local testing or configure these variables securely in your managed
# deployment platform (e.g., Vercel, Railway, Docker Secrets).
# ====================================================================

# 1. CORE APPLICATION RUNTIME
NODE_ENV=production
PORT=3000
NEXT_PUBLIC_APP_URL=https://portal.oakridgeacademy.edu

# 2. MANAGED SUPABASE POSTGRESQL & AUTH
# When configured, the academy connects to your hosted Supabase instance.
# When omitted or empty, the application runs seamlessly in safe offline/demo mode.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.example_anon_key
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.example_service_role_key

# 3. DIRECT DATABASE ACCESS (Required for Automated Migrations & Backups)
# Required only if executing automated backup scripts (scripts/db-backup.sh)
DATABASE_URL=postgresql://postgres.your-project-id:your-db-password@aws-0-us-east-1.pooler.supabase.com:6543/postgres
DB_HOST=aws-0-us-east-1.pooler.supabase.com
DB_PORT=6543
DB_NAME=postgres
DB_USER=postgres.your-project-id
DB_PASSWORD=your_secure_database_password_here

# 4. ARTIFICIAL INTELLIGENCE ENGINES (PHASE 4 & PHASE 7 FAST & SUPER API)
# Primary: High-speed Fast and Super API provider (OpenAI-compatible REST API)
# Compatible with Groq, Cerebras, SuperAI, OpenAI, or any custom OpenAI-compatible endpoint.
FAST_SUPER_API_KEY=your_fast_and_super_api_key_here
FAST_SUPER_API_BASE_URL=https://api.openai.com/v1
FAST_SUPER_MODEL=gpt-4o-mini
FAST_SUPER_TIMEOUT_MS=20000

# Optional fallbacks / secondary cloud AI providers:
GEMINI_API_KEY=AIzaSy_your_production_google_gemini_api_key_here
OPENAI_API_KEY=sk-proj-your_production_openai_api_key_here

# 5. STORAGE & CDN BUCKETS
SUPABASE_STORAGE_BUCKET_DOCUMENTS=academy-documents
SUPABASE_STORAGE_BUCKET_RESOURCES=learning-resources

# 6. APPLICATION SECURITY & SESSION HARDENING
# Cryptographically random string (min 32 characters) used to sign sessions and tokens
SESSION_SECRET=change_this_to_a_minimum_32_character_cryptographically_secure_random_string

# 7. TELEMETRY & HEALTH MONITORING (OPTIONAL)
HEALTHCHECK_SECRET_TOKEN=optional_secret_for_external_synthetic_monitors
